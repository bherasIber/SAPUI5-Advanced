{
  "name": "employees",
  "version": "0.0.1",
  "devDependencies": {
    "@sap/ui5-builder-webide-extension": "1.0.x",
    "@sapui5/ts-types": "1.71.x",
    "@ui5/cli": "^4.0.10",
    "bestzip": "^2.2.1",
    "rimraf": "3.0.2"
  },
  "scripts": {
    "build": "npm run clean && ui5 build --include-task=generateManifestBundle generateCachebusterInfo && npm run zip",
    "zip": "cd dist && npx bestzip ../Employees-content.zip *",
    "clean": "npx rimraf Employees-content.zip dist"
  },
  "ui5": {
    "dependencies": [
      "@sap/ui5-builder-webide-extension"
    ]
  },
  "dependencies": {
    "@sap/approuter": "^17.1.0",
    "@sap/html5-repo-mock": "^1.7.1",
    "uws": "^200.0.0",
    "ws": "^8.18.0"
  }
}
