<c:FragmentDefinition xmlns="sap.m"
    xmlns:c="sap.ui.core">
    <Dialog id="dialog" title="{i18n>orders}">
        <content>
            <Table items="{jsonEmployees>Orders}" width="700px">
                <columns>
                    <Column >
                        <header>
                            <Label text="{i18n>orderID}"/>
                        </header>
                    </Column>
                    <Column >
                        <header>
                            <Label text="{i18n>freight}"/>
                        </header>
                    </Column>
                    <Column >
                        <header>
                            <Label text="{i18n>shipAddress}"/>
                        </header>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem >
                        <cells>
                            <Label text="{jsonEmployees>OrderID}"></Label>
                            <Label text="{jsonEmployees>Freight}"></Label>
                            <Label text="{jsonEmployees>ShipAddress}"></Label>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <endButton>
            <Button text="{i18n>close}" press="onCloseOrders"></Button>
        </endButton>
    </Dialog>
</c:FragmentDefinition>