<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Panel id="controlIdEnFragmento">
		<headerToolbar>
			<Toolbar>
				<core:Icon src="{= ${incidenceModel>Type}==='0' ? 'accept' : ${incidenceModel>Type}==='1' ? 'alert' : ${incidenceModel>Type}==='2' ? 'decline' : ''}"/>
				<Title text="{i18n>incidence} {incidenceModel>IncidenceId} {path:'incidenceModel>CreationDate', formatter:'.formatter.dateFormat'}"></Title>
				<ToolbarSpacer />
				<Button icon="sap-icon://save" press="onSaveIncidence"/>
				<core:Icon  src="delete" press="onDeleteIncidence"/>
			</Toolbar>
		</headerToolbar>
		<content>
			<HBox >
				<VBox class="sapUiSmallMarginEnd">
					<Text text="{i18n>incidenceDate}"></Text>
					<DatePicker dateValue="{incidenceModel>CreationDate}"></DatePicker>
				</VBox>
				<VBox visible="{= ${incidenceModel>CreationDate} !== '' &amp;&amp; ${incidenceModel>CreationDate} !== undefined }" class="sapUiSmallMarginEnd">
					<Text text="{i18n>incidenceReason}"></Text>
					<Input value="{incidenceModel>Reason}"></Input>
				</VBox>
				<VBox visible="{= ${incidenceModel>CreationDate} !== '' &amp;&amp; ${incidenceModel>CreationDate} !== undefined }" class="sapUiSmallMarginEnd">
					<Text text="{i18n>incidenceType}"></Text>
					<Select selectedKey="{incienceModel>Type}" forceSelection="false" change="onStatusChange">
						<core:Item key="0" text="{i18n>incidenceCorrect}"></core:Item>
						<core:Item key="1" text="{i18n>incidencePending}"></core:Item>
						<core:Item key="2" text="{i18n>incidenceError}"></core:Item>
					</Select>
				</VBox>
			</HBox>
		</content>
	</Panel>
</core:FragmentDefinition>