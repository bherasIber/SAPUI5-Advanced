<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Panel id="controlIdEnFragmento">
		<headerToolbar>
			<Toolbar>
				<core:Icon src="{= ${incidenceModel>status}==='0' ? 'accept' : ${incidenceModel>status}==='1' ? 'alert' : ${incidenceModel>status}==='2' ? 'decline' : ''}"/>
				<Title text="{i18n>incidence} {incidenceModel>number} {path:'incidenceModel>date', formatter:'.formatter.dateFormat'}"></Title>
				<ToolbarSpacer />
				<core:Icon  src="delete" press="onDeleteIncidence"/>
			</Toolbar>
		</headerToolbar>
		<content>
			<HBox >
				<VBox class="sapUiSmallMarginEnd">
					<Text text="{i18n>incidenceDate}"></Text>
					<DatePicker dateValue="{incidenceModel>date}"></DatePicker>
				</VBox>
				<VBox visible="{= ${incidenceModel>date} !== '' &amp;&amp; ${incidenceModel>date} !== undefined }" class="sapUiSmallMarginEnd">
					<Text text="{i18n>incidenceReason}"></Text>
					<Input ></Input>
				</VBox>
				<VBox visible="{= ${incidenceModel>date} !== '' &amp;&amp; ${incidenceModel>date} !== undefined }" class="sapUiSmallMarginEnd">
					<Text text="{i18n>incidenceType}"></Text>
					<Select selectedKey="{incienceModel>status}" forceSelection="false" change="onStatusChange">
						<core:Item key="0" text="{i18n>incidenceCorrect}"></core:Item>
						<core:Item key="1" text="{i18n>incidencePending}"></core:Item>
						<core:Item key="2" text="{i18n>incidenceError}"></core:Item>
					</Select>
				</VBox>
			</HBox>
		</content>
	</Panel>
</core:FragmentDefinition>