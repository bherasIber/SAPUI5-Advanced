<mvc:View
	controllerName="logaligroup.employees.controller.Main"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
	displayBlock="true"
	height="100%"
	busyIndicatorDelay="0"
>
    <Page id="pageMain" showHeader="false">
        <content>
            <f:FlexibleColumnLayout id="fcl" backgroundDesign="Solid" layout="{jsonLayouts>/ActiveKey}">
                <f:beginColumnPages>
                    <mvc:XMLView id="masterEmployeeView" viewName="logaligroup.employees.view.MasterEmployee"></mvc:XMLView>
                </f:beginColumnPages>  
                <f:midColumnPages>
                    <mvc:XMLView id="detailEmployeeView" viewName="logaligroup.employees.view.EmployeeDetails"></mvc:XMLView>
                </f:midColumnPages>          
                <f:endColumnPages>
                    <Page id="pageEnd">
                    </Page>
                </f:endColumnPages>
            </f:FlexibleColumnLayout>
        </content>
        <footer>
            <Toolbar id="toolbar">
                <Label id="labelToolbar" text="{i18n>layout}" class="sapUiSmallMargin"></Label>
                <Select id="selectToolbar" items="{jsonLayouts>/Layout}" selectedKey="{jsonLayouts>/ActiveKey}">
                    <core:Item id="itemToolbar" key="{jsonLayouts>Key}" text="{jsonLayouts>Text}"></core:Item>
                </Select>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>