<mvc:View controllerName="logaligroup.employees.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc" 
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="pageId" title="{i18n>title}">
        <content>
            <HBox id="hbox">
                <Label id="labelEmployee" labelFor="inputEmployee" text="{i18n>labelEmployee}" class="sapUiSmallMargin"/>
                <Input id="inputEmployee" value="{jsonCountries>/EmployeeId}" maxLength="6" width="200px" class="sapUiSmallMarginEnd" />
                <Label id="labelCountry" labelFor="slCountry" text="{i18n>labelCountry}" class="sapUiSmallMargin" visible="true"/>
                <Select id="slCountry" selectedKey="{jsonCountries>/CountryKey}" forceSelection="false" items="{jsonCountries>/ListCountry}" visible="true">
                    <items>
                        <core:Item id="itemSelect" key="{jsonCountries>Key}" text="{jsonCountries>Text}"/>
                    </items>
                </Select>
                <Button id="btnFilter" text="{i18n>btnFilter}" icon="sap-icon://search" press="onFilter" class="sapUiSmallMarginEnd"/>
                <Button id="btnClearFilter" text="{i18n>btnClearFilter}" icon="sap-icon://clear-filter" press="onClearFilter" class="sapUiSmallMarginEnd"/>
            </HBox>
            <HBox id="hBoxTable">
                <Panel id="panelTable" >
                    <Button id="btnShowCity" text="{i18n>showCity}" visible="{jsonModelConfig>/visibleBtnShowCity}" press="onShowCity"/>
                    <Button id="btnHideCity" text="{i18n>hideCity}" visible="{jsonModelConfig>/visibleBtnHideCity}" press="onHideCity"/>
                    <Table id="tableEmployee" items="{jsonEmployees>/Employees}">
                        <columns>
                            <Column id="columnId" visible="{jsonModelConfig>/visibleID}">
                                <header>
                                    <Label id="labelId" text="{i18n>tableId}"/>
                                </header>
                            </Column>
                            <Column id="columnName" visible="{jsonModelConfig>/visibleName}">
                                <header>
                                    <Label id="labelName" text="{i18n>tableName}"/>
                                </header>
                            </Column>
                            <Column id="columnCountry" visible="{jsonModelConfig>/visibleCountry}">
                                <header>
                                    <Label id="labelCountryT" text="{i18n>tableCountry}"/>
                                </header>
                            </Column>
                            <Column id="columnCity" visible="{jsonModelConfig>/visibleCity}">
                                <header>
                                    <Label id="labelCity" text="{i18n>tableCity}"/>
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem id="columnListItem"
                                vAlign="Inherit" 
                                type="Active"
                                press="showPostalCode"
                            >
                                <cells>
                                    <Label id="labelID" text="{jsonEmployees>EmployeeID}"/>
                                    <Label id="labelNameC" text="{jsonEmployees>LastName}, {jsonEmployees>FirstName}"/>
                                    <Label id="labelCountryC" text="{jsonEmployees>Country}"/>
                                    <Label id="labelCityC" text="{jsonEmployees>City}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </HBox>
        </content>
    </Page>
</mvc:View>
